# Staging Environment Configuration
# Copy this file to .env.staging and fill in the values
# DO NOT commit this file with real secrets!

# ============================================================
# Database
# ============================================================
DB_USER=taxtrace
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DB_NAME=taxtrace_staging

# ============================================================
# Security
# ============================================================
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_ME_MINIMUM_32_CHARS

# Comma-separated list of allowed origins for CORS
# Example: https://staging.taxtrace.example,https://app.taxtrace.example
ALLOWED_ORIGINS=https://staging.taxtrace.example,http://localhost:3000

# ============================================================
# API / Frontend
# ============================================================
# Full URL to the backend API (used by frontend)
NEXT_PUBLIC_API_URL=https://staging-api.taxtrace.example/api/v1

# ============================================================
# Docker / Deployment
# ============================================================
# GitHub Container Registry image tag for staging
STAGING_TAG=latest

# ============================================================
# Optional: WhatsApp Integration (for staging testing)
# ============================================================
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# ============================================================
# Optional: AI Provider (for staging testing)
# ============================================================
# AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=