# TaxTrace Environment Configuration
# Copy this file to .env and update values for your environment

# Application
APP_NAME=TaxTrace
APP_ENV=development

# Database
# Development: SQLite (default)
# Production: PostgreSQL
DATABASE_URL=postgresql+psycopg://taxtrace:taxtrace@localhost:5432/taxtrace

# Security
# Generate a strong secret key for production: openssl rand -base64 32
SECRET_KEY=dev-secret-key-must-be-at-least-32-bytes-long!

# Storage
STORAGE_DIR=./storage_vault

# CORS - Comma-separated list of allowed origins
# Production: Must be explicit domains (no wildcards)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting (requests per minute/hour per tenant)
RATE_LIMIT_REQUESTS_PER_MINUTE=200
RATE_LIMIT_REQUESTS_PER_HOUR=5000

# File Upload
MAX_UPLOAD_SIZE_BYTES=26214400  # 25 MB

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider (optional)
# AI_PROVIDER=anthropic|openai|mock
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# WhatsApp (optional)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=